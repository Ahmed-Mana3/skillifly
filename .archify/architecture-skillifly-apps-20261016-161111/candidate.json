    {
      "dot": "cyan",
      "title": "Shared data layer",
      "items": [
        "Every app imports its models from core.models; only blog owns its Post, Category and Tag.",
        "Apps call each other as plain Python imports in one process, never over HTTP.",
        "analytics and school only read and write core models, plus the helpers shown."
      ]
    },
    {
      "dot": "violet",
      "title": "Back-references into other apps",
      "items": [
        "core re-exports the portfolios views so older URL names still resolve.",
        "core.urls routes /ar/builder/ and /ar/update/ to builder views.",
        "core.onboarding imports get_client_ip from analytics.",
        "core's payment-tracking page reads its label tables from payments."
      ]
    },
    {
      "dot": "amber",
      "title": "Routing order",
      "items": [
        "payments, builder, analytics, core, school, agent, then portfolios last for the <username>/ catch-all.",
