  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Nginx forwards to Gunicorn; one middleware chain runs before any app.",
        "The portfolios URLconf is last because of its <username>/ catch-all.",
        "WhiteNoise serves static files from inside Django."
      ]
    },
    {
      "dot": "emerald",
      "title": "Data and services",
      "items": [
        "All models live in core, so every app reaches the database through it.",
        "Cloudflare Stream receives video uploads; core only issues the upload URL.",
        "AI copy tries Groq first, then Gemini, then fixed templates."
      ]
    },
    {
      "dot": "amber",
      "title": "Not drawn or not wired",
      "items": [
        "blog, analytics, school and agent apps sit behind the same middleware.",
        "Celery and Redis are configured, but no task or .delay() call exists in code.",
        "Manual receipts are not sent to Gemini: the view only checks the image opens, then auto-verifies."
      ]
    }
  ]
