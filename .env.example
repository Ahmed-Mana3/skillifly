# ============================================================
#  Skillifly — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git — it is listed in .gitignore.
# ============================================================

# ------------------------------------------------------------------
# Django Core  (REQUIRED in production)
# ------------------------------------------------------------------

# A long, random, unique string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key

# Set to False in production — True only for local development.
DJANGO_DEBUG=True

# Comma-separated list of your domain(s) and/or VPS IP.
# Example: skillifly.cloud,www.skillifly.cloud,123.45.67.89
DJANGO_ALLOWED_HOSTS=skillifly.cloud,www.skillifly.cloud
DEFAULT_FROM_EMAIL='Skillifly <noreply@skillifly.cloud>'

# The Django Site ID (usually 1 unless you run multiple sites).
DJANGO_SITE_ID=1

# Comma-separated trusted origins for CSRF protection (required behind Nginx).
# Must include the full scheme (https://).
DJANGO_CSRF_TRUSTED_ORIGINS=https://skillifly.cloud,https://www.skillifly.cloud

# Django log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------
# Database (SQLite)
# ------------------------------------------------------------------
#
# SQLite is used by default. Leave DATABASE_URL empty.
# Make sure the db.sqlite3 file is writable by the web server user (www-data).
#
DATABASE_URL=

# FUTURE PostgreSQL migration (uncomment and fill when ready):
#   Also add psycopg2-binary to requirements.txt at that point.
#
# DATABASE_URL=postgres://skillifly_user:strongpassword@localhost:5432/skillifly_db
# DB_CONN_MAX_AGE=60

# ------------------------------------------------------------------
# Google OAuth2  (leave empty to disable Google login)
# ------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Optional coupon code to bypass payment (e.g. for internal testing).
# Leave empty to disable.
SKILLIFLY_COUPON_CODE=SKILLIFLY2026

# ------------------------------------------------------------------
# Skillifly AI — Agent / Copilot (Groq + Gemini)
# ------------------------------------------------------------------
#
# WITHOUT these keys the AI runs in "Smart Local Mode" (deterministic
# wizards + dev fallback). Add a valid key to enable full AI reasoning.
#
# Get a Groq key at https://console.groq.com  (recommended, primary provider).
# GROQ_API_KEY=gsk_your_groq_key_here

# Optional model overrides (defaults shown below).
# GROQ_AGENT_MODEL=llama-3.3-70b-versatile
# GEMINI_AGENT_MODEL=gemini-2.0-flash

# Gemini is used as an automatic fallback provider and for receipt
# verification. Get a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------
# Celery / Redis  (REQUIRED for async PDF export)
# ------------------------------------------------------------------

# Redis connection URL
CELERY_BROKER_URL=redis://localhost:6379/0

# Set to False in production so tasks run in a real Celery worker.
# Set to True only in development to run tasks synchronously.
CELERY_TASK_ALWAYS_EAGER=False

# ------------------------------------------------------------------
# HTTPS / HSTS  (only enable AFTER HTTPS is fully configured)
# ------------------------------------------------------------------

# Set to True ONLY after Let's Encrypt cert is installed and working.
DJANGO_SECURE_HSTS=False
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------
# Fawaterk Payment Gateway
# ------------------------------------------------------------------
FAWATERK_CLIENT_ID=test_client_id_12345
FAWATERK_CLIENT_SECRET=test_secret_abc123def456
FAWATERK_VENDOR_API_KEY=test_vendor_key_789xyz
FAWATERK_ENV=test

# ------------------------------------------------------------------
# Cloudflare Stream  (video hosting + transcoding)
# ------------------------------------------------------------------
# Video bytes go browser -> Cloudflare directly (tus protocol). Django only
# asks Cloudflare for a one-time upload URL and later receives webhooks.
# The API token is read server-side ONLY and is never sent to the browser.

# Cloudflare account that owns the Stream subscription.
CLOUDFLARE_ACCOUNT_ID=2f1db5c9cd66cff1901c30b702473c73

# Stream customer subdomain, used to build player/iframe URLs.
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=customer-77q2hblzjugdia3y.cloudflarestream.com

# REQUIRED. Cloudflare dashboard -> My Profile -> API Tokens -> Create Token
# -> "Stream" template, with Edit permission.
#   CLOUDFLARE_STREAM_API_TOKEN=

# REQUIRED. Returned once when the webhook is registered. Register it with:
#   python manage.py register_cloudflare_stream_webhook \
#       --url https://your-domain/videos/webhooks/cloudflare-stream/
# The command prints the secret for you to paste here.
#   CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# --- Video limits (optional; defaults shown) ---------------------------------
# Largest single file accepted, in bytes (default 2 GB).
# VIDEO_MAX_UPLOAD_BYTES=2147483648
# Longest clip Cloudflare will retain for an upload, in seconds (default 3600).
# VIDEO_MAX_DURATION_SECONDS=3600
# Base storage allowance per plan tier, in bytes.
# Free users get 256 MB, users with an active Pro payment get 5 GB. Purchased
# storage add-ons are added on top of this (see Profile.storage_addon_bytes).
# VIDEO_STORAGE_FREE_BYTES=268435456
# VIDEO_STORAGE_PRO_BYTES=5368709120

