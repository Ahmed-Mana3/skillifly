{% extends "core/base.html" %}
{% load static %}

{% block title %}لوحة التحكم — Skillifly{% endblock %}

{% block meta_description %}أدر ملفك المهني على Skillifly: شارك رابط ملفك، تابع الزيارات، غيّر التصميم، وافتح المزايا المميزة.{% endblock %}

{% block og_title %}لوحة التحكم — Skillifly{% endblock %}
{% block og_description %}أدر ملفك المهني على Skillifly.{% endblock %}
{% block og_image %}{% static 'img/logo-arabic.png' %}{% endblock %}
{% block twitter_title %}لوحة التحكم — Skillifly{% endblock %}
{% block twitter_description %}أدر ملفك المهني على Skillifly.{% endblock %}
{% block twitter_image %}{% static 'img/logo-arabic.png' %}{% endblock %}

{% block extra_head %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">

<meta property="og:locale" content="ar_AR" />
<meta name="theme-color" content="#3b82f6" />
<meta name="robots" content="noindex, follow" />

<style>
  /* Arabic dashboard — RTL and typography only; rely on core/base colors to keep exact parity with English dashboard */
  @keyframes slideDown {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  .banner-animate {
    animation: slideDown 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes wave {
    0% { transform: rotate(0.0deg) }
    10% { transform: rotate(14.0deg) }
    20% { transform: rotate(-8.0deg) }
    30% { transform: rotate(14.0deg) }
    40% { transform: rotate(-4.0deg) }
    50% { transform: rotate(10.0deg) }
    60% { transform: rotate(0.0deg) }
    100% { transform: rotate(0.0deg) }
  }
  .wave-emoji {
    display: inline-block;
    animation: wave 2.5s infinite;
    transform-origin: 70% 70%;
  }

  /* Keep colors in sync with core/base by not overriding color tokens here */
  body {
    background-color: white !important;
    color: var(--text-primary) !important;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Typography: Cairo for headings, Tajawal for body */
  .arabic-rtl h1,
  .arabic-rtl h2,
  .arabic-rtl h3,
  .arabic-rtl h4 {
    font-family: 'Cairo', 'Tajawal', sans-serif !important;
    letter-spacing: 0 !important;
  }

  .arabic-rtl p,
  .arabic-rtl li,
  .arabic-rtl a,
  .arabic-rtl span,
  .arabic-rtl button,
  .arabic-rtl label {
    font-family: 'Tajawal', 'Cairo', sans-serif !important;
  }

  /* Remove decorative Latin text treatments for Arabic */
  .arabic-rtl .tracking-\[0\.3em\],
  .arabic-rtl .tracking-widest,
  .arabic-rtl .tracking-tighter,
  .arabic-rtl .uppercase {
    letter-spacing: 0 !important;
    text-transform: none !important;
  }

  /* Do not redefine .gradient-text, .btn-primary, .gradient-brand or .gradient-border here — core/base provides the canonical palette */

  /* Card arrows flip + slide (RTL) */
  .arabic-rtl .card-arrow {
    transform: scaleX(-1);
    transition: transform 0.3s ease;
  }
  .arabic-rtl .group:hover .card-arrow {
    transform: scaleX(-1) translateX(-4px);
  }

  /* Focus visibility */
  a:focus-visible,
  button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.35);
    border-radius: 12px;
  }
</style>
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-6 py-12 arabic-rtl">

  {% if not has_active_payment and site_settings.banner_is_active %}
  <!-- Notification Banner -->
  <div id="payment-banner" class="hidden mb-12 banner-animate group">
    <div class="relative overflow-hidden rounded-[2rem] p-[1.5px] bg-gradient-to-br from-blue-500 via-purple-500 to-pink-500 shadow-2xl shadow-purple-500/20 transition-transform duration-500 hover:scale-[1.005]">
      <div class="glass-card rounded-[1.9rem] px-5 py-6 md:px-8 md:py-6 flex flex-col md:flex-row items-center justify-between gap-6 relative z-10">
        
        <!-- Dismiss Button -->
        <button onclick="dismissBanner()" class="absolute top-4 left-4 md:static md:order-last p-2 rounded-full bg-slate-100 hover:bg-slate-200 transition-all text-slate-500 hover:text-black border border-slate-200 md:mr-2" title="إغلاق">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="flex flex-col md:flex-row items-center md:items-start gap-5 w-full md:w-auto">
          <!-- Icon -->
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-400 via-orange-500 to-rose-500 flex items-center justify-center flex-shrink-0 shadow-xl shadow-orange-500/30 group-hover:rotate-6 transition-transform duration-500">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          
          <div class="text-center md:text-right">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 text-[10px] font-bold mb-2">
              عرض محدود
            </div>
            <h3 class="font-bold text-black text-xl md:text-2xl leading-tight mb-2">
              جاهز للنشر <span class="gradient-text">المباشر</span>؟
            </h3>
            <p class="text-slate-600 text-sm md:text-base max-w-md leading-relaxed font-medium">
              انشر ملفك المهني اليوم واحصل على خصم <span class="text-black font-bold">{{ site_settings.banner_discount_percentage }}%</span>
            </p>
          </div>
        </div>
        
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
          <!-- Coupon Code Chip -->
          <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 w-full sm:w-auto justify-center group/coupon cursor-pointer transition-colors hover:bg-slate-100" onclick="copyCoupon()">
            <span class="text-xs text-slate-500 font-bold">الرمز:</span>
            <span id="coupon-text" class="font-mono text-blue-600 font-bold tracking-widest">{{ site_settings.banner_coupon_code }}</span>
            <svg class="w-4 h-4 text-slate-400 group-hover/coupon:text-blue-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>

          <a href="{% url 'payment' %}?coupon={{ site_settings.banner_coupon_code }}" class="btn-primary py-3.5 px-10 text-sm font-bold w-full sm:w-auto shadow-2xl shadow-blue-500/30 hover:shadow-blue-500/50">
            ادفع الآن
          </a>
        </div>
      </div>
      
      <!-- Premium Background elements -->
      <div class="absolute top-0 right-0 -mt-16 -mr-16 w-64 h-64 bg-purple-600/30 rounded-full blur-[100px] pointer-events-none group-hover:bg-purple-500/40 transition-colors duration-700"></div>
      <div class="absolute bottom-0 left-0 -mb-16 -ml-16 w-64 h-64 bg-blue-600/20 rounded-full blur-[100px] pointer-events-none group-hover:bg-blue-500/30 transition-colors duration-700"></div>
      
      <!-- Sparkle/Shine effect -->
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 pointer-events-none"></div>
    </div>
  </div>

